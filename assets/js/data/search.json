---
layout: compress
swcache: true
---

[
  {% assign all_items = site.posts | concat: site.portfolio %}
  {% for item in all_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    {% if item.categories %}
      "categories": {{ item.categories | join: ', ' | jsonify }},
    {% elsif item.category %}
      "categories": {{ item.category | jsonify }},
    {% else %}
      "categories": "",
    {% endif %}
    "tags": {{ item.tags | join: ', ' | jsonify }},
    "date": {{ item.date | jsonify }},
    {% capture content -%}{% include post-summary.html post=item full_text=true %}{%- endcapture -%}
    "content": {{ content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
